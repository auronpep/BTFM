---
type SourceCitation = {
  label: string;
  url: string;
  publisher?: string;
  accessed?: Date;
};

interface Props {
  sources?: SourceCitation[];
}

const { sources = [] } = Astro.props;

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
        timeZone: "UTC",
      }).format(date)
    : undefined;
---

{
  sources.length > 0 && (
    <aside class="source-list" aria-labelledby="source-list-title">
      <h2 id="source-list-title">Source Notes</h2>
      <ul>
        {sources.map((source) => (
          <li>
            <a href={source.url}>{source.label}</a>
            {source.publisher && <span> - {source.publisher}</span>}
            {source.accessed && <small> Accessed {formatDate(source.accessed)}.</small>}
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .source-list {
    border-top: 1px solid var(--color-soft-border);
    padding-top: var(--space-6);
  }

  .source-list h2 {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
  }

  .source-list ul {
    padding-left: 1.1rem;
  }

  .source-list small {
    display: block;
    margin-top: var(--space-1);
  }
</style>
