---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const href = `/articles/${article.id}/`;
const categoryLabel = article.data.category.replaceAll('-', ' ');
---

<article class="article-card">
  <p class="eyebrow">{categoryLabel}</p>
  <h3><a href={href}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
  <dl>
    <div>
      <dt>Use before</dt>
      <dd>{article.data.useBefore.map((item) => item.replaceAll('-', ' ')).join(', ')}</dd>
    </div>
    <div>
      <dt>Attorney review</dt>
      <dd>{article.data.attorneyReviewRequired ? 'Flagged' : 'Not flagged'}</dd>
    </div>
  </dl>
</article>

<style>
  .article-card {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-soft-border);
    border-top: 0.3rem solid var(--color-teal);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-white);
  }

  .article-card > * {
    margin: 0;
  }

  .article-card h3 {
    font-size: 1.45rem;
  }

  .article-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .article-card h3 a:hover {
    color: var(--color-slate);
    text-decoration: underline;
  }

  .article-card p:not(.eyebrow) {
    color: var(--color-muted-ink);
  }

  .article-card dl {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }

  .article-card div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-fog);
  }

  .article-card dt {
    color: var(--color-muted-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .article-card dd {
    margin: 0;
  }

  @media (max-width: 36rem) {
    .article-card div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
