---
const navItems = [
  { label: "Articles", href: "/articles" },
  { label: "Board Rules", href: "/california-board-rules" },
  { label: "Tools", href: "/tools" },
  { label: "Board Training", href: "/training/board-training-program" },
  { label: "Webinars", href: "/training/webinars" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="The Principles of Board Training home">
      <span class="brand-mark" aria-hidden="true">BT</span>
      <span>
        <span class="brand-name">The Principles of Board Training</span>
        <span class="brand-subtitle">Boardroom Field Manual</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="nav-legal" href="https://NPOlawyers.com">Visit NPOlawyers.com</a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile primary navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="nav-legal" href="https://NPOlawyers.com">Visit NPOlawyers.com</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 0.18rem solid var(--color-brass);
    background: var(--color-navy);
    color: var(--color-paper);
    box-shadow: 0 0.35rem 1rem rgba(30, 42, 67, 0.16);
  }

  .header-inner {
    min-height: 4.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 15rem;
    color: var(--color-paper);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-paper);
  }

  .brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(231, 225, 219, 0.35);
    border-radius: 0.18rem;
    background: var(--color-burgundy);
    color: var(--color-paper);
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .brand-name,
  .brand-subtitle {
    display: block;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.18;
  }

  .brand-subtitle {
    color: var(--color-brass);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.7rem, 1.3vw, 1.35rem);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .desktop-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    border-bottom: 0.12rem solid transparent;
    color: var(--color-paper);
    text-decoration: none;
  }

  .desktop-nav a:hover {
    border-bottom-color: var(--color-brass);
    color: var(--color-brass);
  }

  .desktop-nav .nav-legal {
    border: 1px solid rgba(231, 225, 219, 0.16);
    border-bottom-color: rgba(231, 225, 219, 0.16);
    border-radius: var(--radius-sm);
    padding-inline: var(--space-4);
    background: var(--color-burgundy);
    color: var(--color-white);
  }

  .desktop-nav .nav-legal:hover {
    background: var(--color-brass);
    color: var(--color-white);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 68rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      position: relative;
      display: block;
    }

    .mobile-nav summary {
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-items: center;
      gap: 0.22rem;
      border: 1px solid rgba(231, 225, 219, 0.28);
      border-radius: var(--radius-sm);
      background: var(--color-burgundy);
      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav summary span {
      width: 1.1rem;
      height: 0.12rem;
      display: block;
      background: var(--color-paper);
    }

    .mobile-nav nav {
      position: absolute;
      right: 0;
      top: calc(100% + var(--space-2));
      width: min(20rem, calc(100vw - 1.25rem));
      display: grid;
      gap: var(--space-1);
      border: 1px solid var(--color-soft-border);
      border-radius: var(--radius-sm);
      padding: var(--space-2);
      background: var(--color-white);
      box-shadow: 0 1rem 2.5rem var(--color-shadow);
    }

    .mobile-nav nav a {
      min-height: 2.75rem;
      display: flex;
      align-items: center;
      border-radius: 0.18rem;
      padding: var(--space-2) var(--space-3);
      color: var(--color-navy);
      font-weight: 800;
      text-decoration: none;
    }

    .mobile-nav nav a:hover {
      background: rgba(135, 114, 31, 0.14);
    }

    .mobile-nav nav .nav-legal {
      background: var(--color-burgundy);
      color: var(--color-white);
    }
  }
</style>
