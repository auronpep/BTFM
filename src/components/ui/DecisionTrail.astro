---
interface Props {
  steps?: string[];
}

const {
  steps = ["Information", "Deliberation", "Motion", "Vote", "Minutes", "Follow-up"],
} = Astro.props;
---

<section class="decision-trail" aria-label="Decision trail">
  {steps.map((step, index) => (
    <div class="trail-step">
      <span class="trail-number">{index + 1}</span>
      <span>{step}</span>
    </div>
  ))}
</section>

<style>
  .decision-trail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-2);
    margin-block: var(--space-5);
  }

  .trail-step {
    min-height: 5rem;
    display: grid;
    align-content: center;
    gap: var(--space-2);
    border: 1px solid var(--color-soft-border);
    border-top: 0.25rem solid var(--color-brass);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--color-white);
    font-weight: 800;
  }

  .trail-number {
    width: 1.65rem;
    height: 1.65rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
