---
interface AgendaItem {
  time: string;
  title: string;
  cue: string;
  status?: "read" | "ask" | "vote" | "record";
}

interface Props {
  title?: string;
  meta?: string;
  items?: AgendaItem[];
  minutesNote?: string;
}

const {
  title = "Board Meeting Agenda",
  meta = "Packet review / before the meeting",
  items = [
    {
      time: "1",
      title: "Budget variance",
      cue: "What changed from the approved plan?",
      status: "ask",
    },
    {
      time: "2",
      title: "Insurance renewal",
      cue: "Which exclusions or limits need board attention?",
      status: "read",
    },
    {
      time: "3",
      title: "Executive report",
      cue: "What decision does management need?",
      status: "vote",
    },
  ],
  minutesNote = "Minutes should show the motion, authority, vote, recusals, and assigned follow-up.",
} = Astro.props;

const statusLabels = {
  read: "Read",
  ask: "Ask",
  vote: "Vote",
  record: "Record",
};
---

<article class="agenda-preview" aria-label={title}>
  <header class="agenda-preview__header">
    <div>
      <p>{meta}</p>
      <h3>{title}</h3>
    </div>
    <span aria-hidden="true">BT</span>
  </header>

  <ol class="agenda-preview__items">
    {items.map((item) => (
      <li>
        <span class="agenda-preview__number">{item.time}</span>
        <div>
          <strong>{item.title}</strong>
          <p>{item.cue}</p>
        </div>
        {item.status && <em>{statusLabels[item.status]}</em>}
      </li>
    ))}
  </ol>

  <p class="agenda-preview__minutes">{minutesNote}</p>
</article>

<style>
  .agenda-preview {
    border: 1px solid rgba(95, 75, 39, 0.22);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background:
      linear-gradient(rgba(95, 75, 39, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(95, 75, 39, 0.06) 1px, transparent 1px),
      var(--color-white);
    background-size: 2rem 2rem;
    box-shadow: 0 1rem 2.5rem var(--color-shadow);
  }

  .agenda-preview__header {
    display: flex;
    gap: var(--space-4);
    align-items: start;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-soft-border);
    padding-bottom: var(--space-4);
  }

  .agenda-preview__header p,
  .agenda-preview__header h3 {
    margin: 0;
  }

  .agenda-preview__header p {
    color: var(--color-muted-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .agenda-preview__header h3 {
    margin-top: var(--space-1);
    font-size: 1.45rem;
  }

  .agenda-preview__header span {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-serif);
    font-weight: 800;
  }

  .agenda-preview__items {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  .agenda-preview__items li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    border-bottom: 1px solid rgba(95, 75, 39, 0.16);
    padding-bottom: var(--space-3);
  }

  .agenda-preview__number {
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(47, 98, 93, 0.13);
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .agenda-preview strong {
    display: block;
    color: var(--color-ink);
    font-weight: 900;
    line-height: 1.2;
  }

  .agenda-preview__items p {
    margin: var(--space-1) 0 0;
    color: var(--color-muted-ink);
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .agenda-preview em {
    border: 1px solid var(--color-soft-border);
    border-radius: 999px;
    padding: 0.2rem 0.45rem;
    color: var(--color-ink);
    background: rgba(135, 114, 31, 0.12);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .agenda-preview__minutes {
    margin: 0;
    border-left: 0.25rem solid var(--color-records);
    padding: var(--space-3);
    background: rgba(135, 114, 31, 0.12);
    color: var(--color-ink);
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.45;
  }

  @media (max-width: 42rem) {
    .agenda-preview {
      padding: var(--space-4);
    }

    .agenda-preview__items li {
      grid-template-columns: 1.8rem minmax(0, 1fr);
    }

    .agenda-preview em {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
