---
const primaryActions = [
  { label: "Prepare for Your Next Board Meeting", href: "/next-meeting/" },
  { label: "Explore Board Training", href: "/training/" },
  { label: "Visit NPOlawyers.com", href: "https://NPOlawyers.com" },
];
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <p class="home-hero__source">The Principles of Board Training</p>
    <h1 id="home-title">Board service gets serious when the organization gets serious.</h1>
    <p class="home-hero__lead">
      A boardroom field manual for California nonprofit directors reviewing budgets,
      reports, executive oversight, risk, minutes, and decisions that need to hold up
      after the meeting ends.
    </p>
    <div class="home-hero__actions" aria-label="Primary actions">
      {primaryActions.map((action, index) => (
        <a class:list={["home-hero__button", index === 0 && "home-hero__button--primary"]} href={action.href}>
          {action.label}
        </a>
      ))}
    </div>
  </div>
  <div class="home-hero__brief" aria-label="Board meeting preparation snapshot">
    <p class="home-hero__brief-title">$3M Board Member Guide</p>
    <ol>
      <li>Read the packet before the room.</li>
      <li>Ask what changed from budget, plan, or prior vote.</li>
      <li>Separate management updates from board decisions.</li>
      <li>Make the minutes show the action, not the argument.</li>
    </ol>
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 5vw, 4.5rem);
    color: var(--color-ink);
    background:
      linear-gradient(135deg, rgba(231, 225, 219, 0.96), rgba(245, 240, 234, 0.88)),
      radial-gradient(circle at 90% 15%, rgba(135, 114, 31, 0.2), transparent 34%);
  }

  .home-hero__source {
    margin: 0 0 1rem;
    color: var(--color-slate);
    font: 700 0.86rem/1.2 ui-sans-serif, system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0;
    font: 700 clamp(3rem, 7vw, 6.6rem)/0.94 Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  .home-hero__lead {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted-ink);
    font: 400 clamp(1.08rem, 1.7vw, 1.3rem)/1.65 ui-sans-serif, system-ui, sans-serif;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .home-hero__button {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    background: transparent;
    text-decoration: none;
    font: 700 0.95rem/1.2 ui-sans-serif, system-ui, sans-serif;
  }

  .home-hero__button--primary {
    color: var(--color-white);
    background: var(--color-navy);
    border-color: var(--color-navy);
  }

  .home-hero__button:focus-visible {
    outline: 3px solid var(--color-brass);
    outline-offset: 3px;
  }

  .home-hero__brief {
    border-left: 6px solid var(--color-brass);
    padding: 1.5rem;
    background: var(--color-white);
    box-shadow: 0 1rem 3rem var(--color-shadow);
  }

  .home-hero__brief-title {
    margin: 0 0 1rem;
    font: 700 1.2rem/1.2 Georgia, "Times New Roman", serif;
  }

  .home-hero__brief ol {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--color-muted-ink);
    font: 500 1rem/1.45 ui-sans-serif, system-ui, sans-serif;
  }

  @media (max-width: 760px) {
    .home-hero {
      grid-template-columns: 1fr;
      padding-top: 3rem;
    }

    .home-hero h1 {
      max-width: 11ch;
      font-size: clamp(2.55rem, 14vw, 4rem);
    }
  }
</style>
