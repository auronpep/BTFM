---
import AnnotatedPacket from "../ui/AnnotatedPacket.astro";

const primaryActions = [
  { label: "Prepare for Your Next Board Meeting", href: "/next-meeting/" },
  { label: "Explore Board Training", href: "/training/" },
  { label: "Visit NPOlawyers.com", href: "https://NPOlawyers.com" },
];
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <h1 id="home-title" class="display-title">Board service gets serious when the organization gets serious.</h1>
    <p class="home-hero__lead">
      A boardroom field manual for California nonprofit directors reviewing budgets,
      reports, executive oversight, risk, minutes, and decisions that need to hold up
      after the meeting ends.
    </p>
    <ul class="home-hero__sequence" aria-label="Board meeting discipline">
      <li>Read the packet</li>
      <li>Ask the board question</li>
      <li>Record the action</li>
    </ul>
    <div class="home-hero__actions" aria-label="Primary actions">
      {primaryActions.map((action, index) => (
        <a class:list={["home-hero__button", index === 0 && "home-hero__button--primary"]} href={action.href}>
          {action.label}
        </a>
      ))}
    </div>
  </div>
  <div class="home-hero__packet">
    <AnnotatedPacket />
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-16) clamp(1.25rem, 5vw, 4.5rem);
    color: var(--color-ink);
    background: linear-gradient(135deg, rgba(245, 240, 234, 0.88), rgba(231, 225, 219, 0.98));
  }

  .home-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-ink);
  }

  .home-hero__lead {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: var(--type-lead);
    line-height: 1.62;
  }

  .home-hero__sequence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__sequence li {
    border: 1px solid rgba(95, 75, 39, 0.2);
    border-radius: 999px;
    padding: 0.4rem 0.65rem;
    background: rgba(245, 240, 234, 0.72);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .home-hero__button {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    background: transparent;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .home-hero__button--primary {
    color: var(--color-white);
    background: var(--color-navy);
    border-color: var(--color-navy);
  }

  .home-hero__button:focus-visible {
    outline: 3px solid var(--color-brass);
    outline-offset: 3px;
  }

  .home-hero__packet {
    min-width: 0;
  }

  @media (max-width: 760px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      overflow-x: clip;
      padding: var(--space-12) 1rem;
    }

    .home-hero h1 {
      max-width: 13ch;
    }

    .home-hero__actions {
      display: grid;
    }

    .home-hero__button {
      justify-content: center;
      text-align: center;
    }
  }
</style>
