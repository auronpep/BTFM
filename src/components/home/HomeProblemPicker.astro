---
const problems = [
  ["Budget approval", "Know what the board is actually authorizing before the vote."],
  ["Audit or Form 990", "Prepare questions for the audit, tax return, and governance disclosures."],
  ["Executive director report", "Move from listening to oversight without micromanaging."],
  ["Conflict of interest", "Spot when loyalty, disclosure, and abstention need structure."],
  ["Insurance/safety", "Treat safety systems as board risk, not staff housekeeping."],
  ["Annual meeting", "Confirm required actions, elections, minutes, and records."],
];
---

<section class="problem-picker" aria-labelledby="problem-picker-title">
  <div class="problem-picker__intro">
    <h2 id="problem-picker-title">Prepare for the problem on the next agenda.</h2>
    <p>
      Start with the boardroom issue in front of you, then use the guide to ask better
      questions, identify documents, and leave a clean decision trail.
    </p>
  </div>
  <div class="problem-picker__grid">
    {problems.map(([title, description]) => (
      <a class="problem-picker__card" href={`/next-meeting/#${title.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-")}`}>
        <strong>{title}</strong>
        <span>{description}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .problem-picker {
    display: grid;
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    background: var(--color-white);
  }

  .problem-picker h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--type-h2);
    font-weight: 700;
    line-height: 1.02;
  }

  .problem-picker p {
    margin: 1rem 0 0;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .problem-picker__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .problem-picker__card {
    min-height: 9rem;
    padding: 1.1rem;
    border: 1px solid var(--color-soft-border);
    color: var(--color-ink);
    background: var(--color-paper);
    text-decoration: none;
  }

  .problem-picker__card strong,
  .problem-picker__card span {
    display: block;
  }

  .problem-picker__card strong {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .problem-picker__card span {
    margin-top: 0.65rem;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .problem-picker__card:hover {
    border-color: var(--color-slate);
    background: var(--color-white);
  }

  .problem-picker__card:focus-visible {
    outline: 3px solid var(--color-brass);
    outline-offset: 3px;
  }

  @media (max-width: 800px) {
    .problem-picker,
    .problem-picker__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
