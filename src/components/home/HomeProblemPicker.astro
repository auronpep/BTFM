---
const problems = [
  {
    title: "Budget approval",
    label: "Money",
    accent: "var(--color-teal)",
    description: "Know what the board is actually authorizing before the vote.",
  },
  {
    title: "Audit or Form 990",
    label: "Audit",
    accent: "var(--color-records)",
    description: "Prepare questions for the audit, tax return, and governance disclosures.",
  },
  {
    title: "Executive director report",
    label: "Oversight",
    accent: "var(--color-slate)",
    description: "Move from listening to oversight without micromanaging.",
  },
  {
    title: "Conflict of interest",
    label: "Rules",
    accent: "var(--color-rules)",
    description: "Spot when loyalty, disclosure, and abstention need structure.",
  },
  {
    title: "Insurance/safety",
    label: "Risk",
    accent: "var(--color-risk)",
    description: "Treat safety systems as board risk, not staff housekeeping.",
  },
  {
    title: "Annual meeting",
    label: "Records",
    accent: "var(--color-brass)",
    description: "Confirm required actions, elections, minutes, and records.",
  },
];
---

<section class="problem-picker" aria-labelledby="problem-picker-title">
  <div class="problem-picker__intro">
    <h2 id="problem-picker-title">Prepare for the problem on the next agenda.</h2>
    <p>
      Start with the boardroom issue in front of you, then use the guide to ask better
      questions, identify documents, and leave a clean decision trail.
    </p>
  </div>
  <div class="problem-picker__grid">
    {problems.map((problem, index) => (
      <a
        class="problem-picker__row"
        href={`/next-meeting/#${problem.title.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-")}`}
        style={`--problem-accent: ${problem.accent}`}
      >
        <span class="problem-picker__number">{String(index + 1).padStart(2, "0")}</span>
        <span class="problem-picker__body">
          <strong>{problem.title}</strong>
          <span>{problem.description}</span>
        </span>
        <em>{problem.label}</em>
      </a>
    ))}
  </div>
</section>

<style>
  .problem-picker {
    display: grid;
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    background: var(--color-white);
  }

  .problem-picker h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--type-h2);
    font-weight: 700;
    line-height: 1.02;
  }

  .problem-picker p {
    margin: 1rem 0 0;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .problem-picker__grid {
    display: grid;
    gap: 1px;
    background: rgba(86, 68, 36, 0.18);
  }

  .problem-picker__row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: start;
    min-height: 6.25rem;
    padding: var(--space-4);
    border-left: 0.26rem solid var(--problem-accent);
    color: var(--color-ink);
    background: var(--color-white);
    text-decoration: none;
  }

  .problem-picker__number {
    color: var(--problem-accent);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .problem-picker__body,
  .problem-picker__body strong,
  .problem-picker__body span {
    display: block;
  }

  .problem-picker__body strong {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .problem-picker__body span {
    margin-top: 0.45rem;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .problem-picker__row em {
    border: 1px solid rgba(86, 68, 36, 0.18);
    padding: 0.22rem 0.45rem;
    color: var(--problem-accent);
    background: rgba(251, 248, 242, 0.76);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .problem-picker__row:hover {
    background: rgba(251, 248, 242, 0.88);
  }

  .problem-picker__row:focus-visible {
    outline: 3px solid var(--color-brass);
    outline-offset: 3px;
  }

  @media (max-width: 800px) {
    .problem-picker,
    .problem-picker__grid {
      grid-template-columns: 1fr;
    }

    .problem-picker__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }

    .problem-picker__row em {
      justify-self: start;
    }
  }
</style>
