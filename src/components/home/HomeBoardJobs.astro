---
const jobs = [
  {
    title: "Strategy",
    text: "The board decides the direction, tradeoffs, and permissions that management should not guess at alone.",
  },
  {
    title: "Safety",
    text: "The board asks whether people, programs, insurance, reporting channels, and policies match the real risk.",
  },
  {
    title: "Audit",
    text: "The board verifies money, records, controls, public filings, and minutes before confidence becomes habit.",
  },
];
---

<section class="board-jobs" aria-labelledby="board-jobs-title">
  <h2 id="board-jobs-title">The three jobs that make board service real.</h2>
  <div class="board-jobs__list">
    {jobs.map((job) => (
      <article class="board-jobs__item">
        <h3>{job.title}</h3>
        <p>{job.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .board-jobs {
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    color: var(--color-white);
    background: var(--color-navy);
  }

  .board-jobs h2 {
    max-width: 15ch;
    margin: 0;
    font: 700 clamp(2rem, 4vw, 3.4rem)/1.05 Georgia, "Times New Roman", serif;
  }

  .board-jobs__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2rem;
    background: rgba(231, 225, 219, 0.26);
  }

  .board-jobs__item {
    min-height: 15rem;
    padding: 1.35rem;
    background: var(--color-navy);
  }

  .board-jobs h3 {
    margin: 0;
    color: var(--color-brass);
    font: 700 1.6rem/1.1 Georgia, "Times New Roman", serif;
  }

  .board-jobs p {
    margin: 1rem 0 0;
    color: rgba(245, 240, 234, 0.86);
    font: 400 1rem/1.6 ui-sans-serif, system-ui, sans-serif;
  }

  @media (max-width: 800px) {
    .board-jobs__list {
      grid-template-columns: 1fr;
    }

    .board-jobs__item {
      min-height: auto;
    }
  }
</style>
