---
const tools = [
  "Board Packet Review Sheet",
  "Budget Deviation Worksheet",
  "Minutes Quality Scorecard",
];

const scenarios = [
  "The Board Packet Arrived Too Late",
  "The Finance Committee Says Everything Is Fine",
  "The Minutes Are Long, But No One Knows What Passed",
];
---

<section class="resources" aria-labelledby="resources-title">
  <div class="resources__heading">
    <h2 id="resources-title">Field manual entries, not filler articles.</h2>
    <p>
      Tools and scenarios are written for directors who need to prepare, ask,
      vote, and document with discipline.
    </p>
  </div>
  <div class="resources__columns">
    <article>
      <h3>Featured tools</h3>
      <ul>
        {tools.map((tool, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{tool}</li>)}
      </ul>
      <a href="/tools/">Open the tools library</a>
    </article>
    <article>
      <h3>Featured scenarios</h3>
      <ul>
        {scenarios.map((scenario, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{scenario}</li>)}
      </ul>
      <a href="/scenarios/">Read boardroom scenarios</a>
    </article>
  </div>
</section>

<section class="training-band" aria-labelledby="training-title">
  <div>
    <h2 id="training-title">Bring the field manual into the boardroom.</h2>
    <p>
      Use the free guides first. When your board needs a shared language for
      strategy, safety, audit, executive oversight, or difficult decisions, ask
      about webinar or in-person training.
    </p>
  </div>
  <div class="training-band__actions">
    <a class="button" href="/training/">Explore training</a>
    <a class="button legal" href="https://NPOlawyers.com">Visit NPOlawyers.com</a>
  </div>
</section>

<style>
  .resources {
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    background: var(--color-paper);
  }

  .resources__heading {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
  }

  .resources h2,
  .training-band h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--type-h2);
    font-weight: 700;
    line-height: 1.05;
  }

  .resources__heading p,
  .training-band p {
    margin: 0;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .resources__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .resources article {
    border-left: 0.28rem solid var(--color-slate);
    padding: var(--space-5);
    background: var(--color-white);
    box-shadow: 0 0.55rem 1.35rem var(--color-shadow);
  }

  .resources article + article {
    border-left-color: var(--color-records);
  }

  .resources h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .resources ul {
    display: grid;
    gap: 1px;
    margin: 1rem 0 1.25rem;
    padding: 0;
    color: var(--color-muted-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    list-style: none;
    background: rgba(86, 68, 36, 0.14);
  }

  .resources li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    margin: 0;
    padding: var(--space-3);
    background: rgba(251, 248, 242, 0.72);
  }

  .resources li span {
    color: var(--color-brass);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .resources a,
  .training-band a {
    color: var(--color-slate);
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .resources a:focus-visible,
  .training-band a:focus-visible {
    outline: 3px solid var(--color-brass);
    outline-offset: 3px;
  }

  .training-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.5rem);
    background:
      linear-gradient(90deg, rgba(30, 42, 67, 0.08), transparent 46%),
      var(--color-white);
    border-top: 1px solid var(--color-fog);
    border-bottom: 0.18rem solid var(--color-brass);
  }

  .training-band p {
    max-width: 50rem;
    margin-top: 0.9rem;
  }

  .training-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }

  .training-band__actions .button,
  .training-band__actions .button:hover {
    color: var(--color-white);
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .resources__heading,
    .resources__columns,
    .training-band {
      grid-template-columns: 1fr;
    }

    .training-band__actions {
      justify-content: stretch;
    }

    .training-band__actions .button {
      width: 100%;
    }
  }
</style>
