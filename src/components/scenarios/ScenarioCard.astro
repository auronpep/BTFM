---
import type { CollectionEntry } from 'astro:content';

interface Props {
  scenario: CollectionEntry<'scenarios'>;
}

const { scenario } = Astro.props;
const href = `/scenarios/${scenario.id}/`;
const categoryLabel = scenario.data.category.replaceAll('-', ' ');
---

<article class="scenario-card">
  <p class="eyebrow">{categoryLabel}</p>
  <h3><a href={href}>{scenario.data.title}</a></h3>
  <p>{scenario.data.boardroomProblem}</p>
  <p class="pressure">{scenario.data.decisionPressure ?? scenario.data.description}</p>
</article>

<style>
  .scenario-card {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-soft-border);
    border-top: 0.3rem solid var(--color-copper);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-white);
  }

  .scenario-card > * {
    margin: 0;
  }

  .scenario-card h3 {
    font-size: 1.45rem;
  }

  .scenario-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .scenario-card h3 a:hover {
    color: var(--color-slate);
    text-decoration: underline;
  }

  .scenario-card p:not(.eyebrow) {
    color: var(--color-muted-ink);
  }

  .scenario-card .pressure {
    border-top: 1px solid var(--color-fog);
    padding-top: var(--space-3);
    color: var(--color-ink);
    font-weight: 800;
  }
</style>
