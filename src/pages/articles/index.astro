---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleIndex from '../../components/articles/ArticleIndex.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);

const title = 'Meeting-Ready Articles';
const description =
  'Field manual articles for California nonprofit board members preparing for budgets, audits, executive oversight, minutes, risk, and board decisions.';
---

<BaseLayout title={title} description={description} canonicalPath="/articles/">
  <ArticleIndex articles={articles} />
</BaseLayout>
