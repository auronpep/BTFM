---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeProblemPicker from "../components/home/HomeProblemPicker.astro";
import HomeBoardJobs from "../components/home/HomeBoardJobs.astro";
import HomeResourceSections from "../components/home/HomeResourceSections.astro";

const title = "The Principles of Board Training";
const description =
  "A boardroom field manual for California nonprofit directors preparing for serious board meetings, budgets, reports, risk, minutes, and training.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <HomeHero />
  <HomeProblemPicker />
  <HomeBoardJobs />
  <HomeResourceSections />
</BaseLayout>
