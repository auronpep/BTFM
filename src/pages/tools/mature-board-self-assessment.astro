---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolHero from "../../components/tools/ToolHero.astro";

const dimensions = [
  {
    title: "Strategy",
    prompts: [
      "The board can name the three decisions that matter most this year.",
      "Reports are tied to goals, risk, budget, and material changes.",
      "The board can distinguish oversight from operational preference.",
    ],
  },
  {
    title: "Safety",
    prompts: [
      "Insurance, youth protection, personnel risk, and internal controls are reviewed on a schedule.",
      "The board knows which risks require immediate escalation.",
      "Directors understand that silence can become evidence of inattention.",
    ],
  },
  {
    title: "Audit",
    prompts: [
      "Financial statements, budgets, audit materials, and Form 990 are reviewed before approval.",
      "The board asks about deviations, assumptions, restrictions, and reserves.",
      "Minutes preserve the exact decision and packet relied on.",
    ],
  },
];

const title = "Mature Board Self-Assessment";
const description =
  "A practical self-assessment for established governing boards with staff, budgets, audit exposure, insurance, and board-level risk.";
---

<BaseLayout title={title} description={description} canonicalPath="/tools/mature-board-self-assessment/">
  <ToolHero
    eyebrow="Assessment"
    title="Mature Board Self-Assessment"
    deck="Use this before a board retreat, annual meeting, or training session to test whether the board has grown beyond startup habits."
    actions={[
      { label: "Download Assessment", href: "/downloads/mature-board-self-assessment.md" },
      { label: "Open Training", href: "/training", variant: "secondary" },
    ]}
  />

  <section class="assessment" aria-labelledby="assessment-title">
    <div class="assessment__header">
      <p class="eyebrow">Scorecard</p>
      <h2 id="assessment-title">Rate each statement: not yet, inconsistent, reliable</h2>
      <p>
        This is a discussion tool, not a legal conclusion. Low scores identify
        training needs, policy work, professional support, or items to place on
        the governance calendar.
      </p>
    </div>
    <div class="assessment__grid">
      {
        dimensions.map((dimension) => (
          <article class="boardroom-card">
            <p class="boardroom-label">{dimension.title}</p>
            <h3 class="boardroom-title">{dimension.title} discipline</h3>
            <ul>
              {dimension.prompts.map((prompt) => <li>{prompt}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .assessment {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 5vw, 4rem);
  }

  .assessment__header {
    max-width: 54rem;
    margin-bottom: var(--space-8);
  }

  .assessment__header p:not(.eyebrow) {
    color: var(--color-muted-ink);
    font-size: 1.08rem;
  }

  .assessment__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-5);
  }
</style>
