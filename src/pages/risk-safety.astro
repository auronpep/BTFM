---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicLanding from "../components/topic/TopicLanding.astro";
import { topicPages } from "../data/topic-pages";
import { getTopicResources } from "../utils/topic-content";

const config = topicPages["risk-safety"];
const resources = await getTopicResources(config.slug);
---

<BaseLayout title={config.title} description={config.description} canonicalPath="/risk-safety/">
  <TopicLanding config={config} resources={resources} />
</BaseLayout>
