---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrainingInquiryForm from "../../components/forms/TrainingInquiryForm.astro";

const pageTitle = "Board Training Program";
const description =
  "A standalone course-style overview of the board training program, with webinars, in-person sessions, board packet practice, downloadable tools, and NPO Lawyers referral paths.";

const facts = [
  { label: "Start with", value: "Free resources" },
  { label: "Best for", value: "Working boards" },
  { label: "Core session", value: "75-90 minutes" },
  { label: "Format", value: "Webinar or in person" },
  { label: "Legal path", value: "NPOlawyers.com" },
];

const introCards = [
  {
    title: "Board Authority",
    body: "Directors learn what belongs to the board, what belongs to officers or staff, and why individual board members do not act alone.",
  },
  {
    title: "Oversight Evidence",
    body: "The program turns budgets, audit materials, executive reports, minutes, conflicts, and Form 990 questions into practical board behavior.",
  },
  {
    title: "Meeting Discipline",
    body: "Board members practice asking better questions before the meeting, making clear motions, and leaving minutes that prove the board did its job.",
  },
];

const scenarios = [
  {
    title: "The executive director wants a raise",
    body: "Practice disinterested review, comparability, recusal, minutes evidence, and when compensation needs legal review.",
    href: "/scenarios/executive-director-wants-a-raise",
  },
  {
    title: "The board packet arrived too late",
    body: "Decide what can be approved, what should be tabled, and what directors should ask for before voting.",
    href: "/scenarios/board-packet-arrived-too-late",
  },
  {
    title: "The minutes are long, but unclear",
    body: "Separate discussion notes from board action and learn what the record should show after a serious decision.",
    href: "/scenarios/minutes-long-no-one-knows-what-passed",
  },
];

const relatedResources = [
  {
    title: "Board Article Library",
    body: "Plain-English articles on board duties, meetings, oversight, records, conflicts, and when legal help is needed.",
    href: "/articles/",
  },
  {
    title: "Board Packet Lab",
    body: "A guided practice area for reviewing agenda decisions, missing documents, oversight questions, and minutes notes.",
    href: "/tools/board-packet-lab",
  },
  {
    title: "California Board Rules",
    body: "Issue spotters for audit thresholds, compensation, conflicts, records, filings, fundraising, and public disclosure.",
    href: "/california-board-rules",
  },
];
---

<BaseLayout title={pageTitle} description={description} canonicalPath="/training/board-training-program" pageType="training">
  <section class="program-alert" aria-label="Program notice">
    <div class="container program-alert-inner">
      <span>Free online board resources are available now.</span>
      <a href="#program-inquiry">Ask about webinar or in-person training</a>
    </div>
  </section>

  <section class="program-hero">
    <div class="container program-hero-grid">
      <div class="program-hero-copy">
        <p class="eyebrow">Program Level</p>
        <h1 class="program-title">
          <span>Board</span>
          <span>training</span>
          <span>for the next</span>
          <span>hard vote</span>
        </h1>
        <div class="program-status">
          <span aria-hidden="true"></span>
          Built for directors, chairs, presidents, founders, and executive leaders.
        </div>
        <p class="program-hero-text">
          The Principles of Board Training packages the field manual into a practical course path: read the board
          packet, spot the board-level issue, ask the right questions, document the decision, and know when the issue
          belongs with board counsel.
        </p>
        <div class="program-actions" aria-label="Program actions">
          <a class="button" href="/training/webinars" data-conversion-event="program_page_webinar_click">
            Register for a Webinar
          </a>
          <a class="button secondary" href="/training/in-person" data-conversion-event="program_page_in_person_click">
            Request In-Person Training
          </a>
        </div>
      </div>

      <aside class="program-visual" aria-label="Board packet preview">
        <div class="packet-cover">
          <span class="packet-label">Board Packet</span>
          <h2>Strategy. Safety. Audit.</h2>
          <p>Questions, motions, documents, minutes, and legal escalation prompts.</p>
        </div>
        <div class="packet-sheet">
          <span>Before the meeting</span>
          <strong>What decision is the board actually making?</strong>
        </div>
        <div class="packet-sheet muted">
          <span>After the meeting</span>
          <strong>What should the minutes prove?</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="program-facts" aria-label="Program facts">
    <div class="container program-facts-grid">
      {facts.map((fact) => (
        <div class="program-fact">
          <span>{fact.label}</span>
          <strong>{fact.value}</strong>
        </div>
      ))}
      <a class="program-facts-action" href="/training/webinars" data-conversion-event="program_facts_webinar_click">
        View webinars
      </a>
    </div>
  </section>

  <section class="program-section program-three-jobs" aria-labelledby="three-jobs-heading">
    <div class="container">
      <div class="program-section-heading centered">
        <p class="eyebrow">Governance Framework</p>
        <h2 id="three-jobs-heading">The Three Jobs of a Mature Board</h2>
        <p>
          A governing body must focus on three core responsibilities to ensure the organization stays stable, compliant, and clear on its long-term direction.
        </p>
      </div>
      <div class="program-card-grid program-three-jobs-grid">
        <article class="program-card program-three-jobs-card">
          <div class="program-three-jobs-number">01</div>
          <h3>Strategy</h3>
          <p>The board decides the direction, tradeoffs, and permissions that management should not guess at alone.</p>
        </article>
        <article class="program-card program-three-jobs-card">
          <div class="program-three-jobs-number">02</div>
          <h3>Safety</h3>
          <p>The board asks whether people, programs, insurance, reporting channels, and policies match the real risk.</p>
        </article>
        <article class="program-card program-three-jobs-card">
          <div class="program-three-jobs-number">03</div>
          <h3>Audit</h3>
          <p>The board verifies money, records, controls, public filings, and minutes before confidence becomes habit.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="program-section program-section--dark-executive" aria-labelledby="program-why-heading">
    <div class="container">
      <div class="program-section-heading centered">
        <h2 id="program-why-heading">Many boards are active. Few are effective.</h2>
        <p>
          The difference is usually not goodwill. It is clarity about authority, oversight, records, and the practical
          habits that make a board useful before something goes wrong.
        </p>
      </div>
      <div class="program-card-grid">
        {introCards.map((card) => (
          <article class="program-card program-card--dark-executive">
            <span class="program-card-icon" aria-hidden="true"></span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="program-promise">
    <div class="container program-promise-panel">
      <div>
        <p class="eyebrow">Free resources first</p>
        <h2>Use the tools before you book training</h2>
        <p>
          The online field manual and downloadable files stay free. Webinars and in-person sessions are for boards that
          want a shared training experience, a retreat format, or a guided walk through real boardroom issues.
        </p>
        <div class="program-promise-actions">
          <a class="button secondary" href="/articles/" data-conversion-event="program_page_articles_click">
            Read the Article Library
          </a>
        </div>
      </div>
      <div class="promise-stamp" aria-hidden="true">
        <span>Free</span>
        <strong>Field Manual</strong>
      </div>
    </div>
  </section>

  <section class="program-curriculum" aria-labelledby="program-curriculum-heading">
    <div class="container program-curriculum-layout">
      <div class="program-curriculum-copy">
        <p class="eyebrow">Curriculum</p>
        <h2 id="program-curriculum-heading">What the training covers</h2>
        <p>
          The program follows the same tabbed course-page structure as the reference clone, but the content is tailored
          to board behavior and California organizational risk.
        </p>
        <a class="button secondary" href="/tools/board-packet-lab">Open the Board Packet Lab</a>
      </div>

      <fieldset class="program-tabs">
        <legend class="program-tabs-legend">Choose a curriculum focus</legend>
        <input id="tab-directors" name="program-tabs" type="radio" aria-controls="panel-directors" checked />
        <label id="tab-label-directors" for="tab-directors">Directors</label>
        <input id="tab-officers" name="program-tabs" type="radio" aria-controls="panel-officers" />
        <label id="tab-label-officers" for="tab-officers">Chairs & Presidents</label>
        <input id="tab-oversight" name="program-tabs" type="radio" aria-controls="panel-oversight" />
        <label id="tab-label-oversight" for="tab-oversight">Money & Risk</label>
        <input id="tab-meetings" name="program-tabs" type="radio" aria-controls="panel-meetings" />
        <label id="tab-label-meetings" for="tab-meetings">Annual Meeting</label>

        <div class="tab-panels">
          <article id="panel-directors" class="tab-panel panel-directors" role="region" aria-labelledby="tab-label-directors">
            <p class="tab-kicker">Director fundamentals</p>
            <ol>
              <li>What the board can do that individual directors cannot.</li>
              <li>How to read a packet for decisions, missing information, and red flags.</li>
              <li>How duties of care, loyalty, and obedience show up in ordinary votes.</li>
              <li>What questions belong in the meeting before the board approves action.</li>
            </ol>
          </article>
          <article id="panel-officers" class="tab-panel panel-officers" role="region" aria-labelledby="tab-label-officers">
            <p class="tab-kicker">Officer and chair practice</p>
            <ol>
              <li>Build agendas that separate reports, decisions, consent items, and follow-up.</li>
              <li>Keep board-management boundaries clear between meetings.</li>
              <li>Handle difficult board member behavior without turning every issue into a legal fight.</li>
              <li>Use committees without losing board accountability.</li>
            </ol>
          </article>
          <article id="panel-oversight" class="tab-panel panel-oversight" role="region" aria-labelledby="tab-label-oversight">
            <p class="tab-kicker">Money, audit, and risk</p>
            <ol>
              <li>Review budgets, variances, reserves, and restricted funds without pretending to be staff.</li>
              <li>Know what audit, Form 990, insurance, safety, and internal-control questions belong to the board.</li>
              <li>Document conflicts, recusals, compensation approvals, and financial follow-up.</li>
              <li>Recognize when the board should pause and get legal advice.</li>
            </ol>
          </article>
          <article id="panel-meetings" class="tab-panel panel-meetings" role="region" aria-labelledby="tab-label-meetings">
            <p class="tab-kicker">Board rhythm</p>
            <ol>
              <li>Prepare for the annual meeting before officer elections and compliance questions become urgent.</li>
              <li>Use the 40-40-20 meeting rule to reduce passive report-listening.</li>
              <li>Leave minutes that show action, authority, votes, recusals, and assigned follow-up.</li>
              <li>Turn the next board meeting into a repeatable governance routine.</li>
            </ol>
          </article>
        </div>
      </fieldset>
    </div>
  </section>

  <section class="program-legal-callout">
    <div class="container program-legal-panel">
      <div>
        <p class="eyebrow">When training is not enough</p>
        <h2>Some board problems need board counsel</h2>
        <p>
          The training page should teach practical issue spotting, but it should also move serious legal questions to
          the law firm site without making the resource library feel like a sales brochure.
        </p>
      </div>
      <a class="button legal" href="https://NPOlawyers.com" data-conversion-event="program_page_npo_lawyers_click">
        Visit NPOlawyers.com
      </a>
    </div>
  </section>

  <section class="program-join">
    <div class="container program-join-panel">
      <div>
        <p class="eyebrow">For working boards</p>
        <h2>Train the board before the next hard vote</h2>
      </div>
      <p>
        The best session is not abstract. Bring the board's real pressure points: budget approval, executive oversight,
        officer roles, records, audit, insurance, safety, conflict review, or annual meeting discipline.
      </p>
      <a class="button" href="#program-inquiry" data-conversion-event="program_join_inquiry_click">Start an Inquiry</a>
    </div>
  </section>

  <section class="program-section" aria-labelledby="program-scenarios-heading">
    <div class="container">
      <div class="program-section-heading">
        <p class="eyebrow">Practice scenarios</p>
        <h2 id="program-scenarios-heading">What boards work through in training</h2>
      </div>
      <div class="program-card-grid">
        {scenarios.map((scenario) => (
          <article class="program-card scenario-card">
            <h3>{scenario.title}</h3>
            <p>{scenario.body}</p>
            <a href={scenario.href}>Read the scenario</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="program-about" aria-labelledby="program-about-heading">
    <div class="container program-about-grid">
      <div class="about-visual" aria-hidden="true">
        <div>Agenda</div>
        <div>Budget</div>
        <div>Minutes</div>
        <div>Follow-up</div>
      </div>
      <div>
        <p class="eyebrow">Publisher</p>
        <h2 id="program-about-heading">Published by California Center for Nonprofit Law / NPO Lawyers</h2>
        <p>
          This resource is educational. It is designed to help board members prepare, govern, and know when
          an issue has crossed from general training into organization-specific legal advice.
        </p>
        <ul class="program-check-list">
          <li>Free field-manual articles and scenario guides.</li>
          <li>Downloadable meeting and oversight tools.</li>
          <li>Webinar and in-person training paths.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="program-section" aria-labelledby="program-resources-heading">
    <div class="container">
      <div class="program-section-heading">
        <p class="eyebrow">Related resources</p>
        <h2 id="program-resources-heading">Start with these before booking a session</h2>
      </div>
      <div class="program-card-grid">
        {relatedResources.map((resource) => (
          <article class="program-card resource-card">
            <h3>{resource.title}</h3>
            <p>{resource.body}</p>
            <a href={resource.href}>Open resource</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="program-inquiry-section container" id="program-inquiry">
    <TrainingInquiryForm
      formName="program-training-inquiry"
      eventName="program_page_training_inquiry_submit_mailto"
      heading="Ask about webinar or in-person board training"
      intro="Use this static-site inquiry path to ask about the next webinar, a board retreat, a private training session, or a group presentation."
      defaultInterest="private-training"
    />
  </section>

  <div class="program-mobile-sticky">
    <a href="#program-inquiry">Ask about training</a>
  </div>
</BaseLayout>

<style>
  /* Three Jobs (Option 1: Symmetrical triptych grid) */
  .program-three-jobs {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-soft-border);
  }

  .program-three-jobs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .program-three-jobs-card {
    min-height: 15rem;
    border-top: 0.35rem solid var(--color-brass);
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: 0 0.75rem 1.875rem var(--color-shadow);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .program-three-jobs-number {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 900;
    color: var(--color-brass);
    letter-spacing: 0.1em;
  }

  .program-three-jobs-card h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-ink);
    margin: 0;
  }

  .program-three-jobs-card p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted-ink);
    margin: 0;
  }

  /* Option 3: Dark executive boardroom panel */
  .program-section--dark-executive {
    background: var(--color-navy);
    color: var(--color-paper);
    border-top: 4px solid var(--color-brass);
    border-bottom: 1px solid rgba(231, 225, 219, 0.1);
  }

  .program-section--dark-executive h2 {
    color: var(--color-white) !important;
  }

  .program-section--dark-executive p {
    color: rgba(231, 225, 219, 0.85) !important;
  }

  .program-card--dark-executive {
    background: #152038 !important;
    border: 1px solid rgba(231, 225, 219, 0.12) !important;
    border-top: 0.35rem solid var(--color-brass) !important;
    box-shadow: 0 0.75rem 2.5rem rgba(0, 0, 0, 0.35) !important;
  }

  .program-card--dark-executive h3 {
    color: var(--color-white) !important;
  }

  .program-card--dark-executive p {
    color: rgba(231, 225, 219, 0.8) !important;
  }

  .program-card--dark-executive .program-card-icon {
    background:
      linear-gradient(90deg, transparent 42%, var(--color-brass) 42%, var(--color-brass) 58%, transparent 58%),
      linear-gradient(180deg, transparent 42%, var(--color-brass) 42%, var(--color-brass) 58%, transparent 58%),
      rgba(216, 199, 106, 0.18) !important;
    border-color: rgba(231, 225, 219, 0.2) !important;
  }

  .program-alert {
    border-bottom: 1px solid rgba(231, 225, 219, 0.18);
    background: var(--color-slate);
    color: var(--color-paper);
  }

  .program-alert-inner {
    min-height: 2.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
    font-weight: 800;
  }

  .program-alert-inner > * {
    min-width: 0;
    max-width: 100%;
  }

  .program-alert a {
    color: var(--color-paper);
    overflow-wrap: anywhere;
    text-decoration-color: rgba(231, 225, 219, 0.5);
  }

  .program-hero {
    background: var(--color-white);
    padding: var(--space-16) 0 0;
  }

  .program-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(20rem, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-width: 0;
    overflow-x: clip;
  }

  .program-hero-copy {
    padding-bottom: var(--space-12);
    min-width: 0;
  }

  .program-hero-copy h1 {
    max-width: 11ch;
    color: var(--color-ink);
    line-height: 0.98;
    overflow-wrap: break-word;
  }

  .program-hero-copy h1 span {
    display: block;
  }

  .program-status {
    width: fit-content;
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-5);
    background: rgba(135, 114, 31, 0.14);
    color: var(--color-ink);
    font-weight: 800;
  }

  .program-status span {
    width: 0.35rem;
    background: var(--color-brass);
  }

  .program-status {
    padding: 0.65rem 1rem 0.65rem 0;
  }

  .program-hero-text {
    max-width: 42rem;
    color: var(--color-muted-ink);
    font-size: 1.12rem;
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .program-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .program-visual {
    position: relative;
    min-height: 32rem;
    display: grid;
    align-content: end;
    padding: var(--space-8);
    background:
      linear-gradient(90deg, rgba(30, 42, 67, 0.12) 1px, transparent 1px),
      linear-gradient(180deg, rgba(30, 42, 67, 0.12) 1px, transparent 1px),
      var(--color-paper);
    background-size: 2.5rem 2.5rem;
    border-left: 0.45rem solid var(--color-brass);
  }

  .packet-cover,
  .packet-sheet {
    border: 1px solid var(--color-soft-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: 0 1rem 2.5rem var(--color-shadow);
  }

  .packet-cover {
    max-width: 26rem;
    min-height: 18rem;
    display: grid;
    align-content: end;
    padding: var(--space-6);
    background: var(--color-navy);
    color: var(--color-paper);
  }

  .packet-cover h2 {
    max-width: 9ch;
    color: var(--color-white);
    font-size: var(--type-h2);
  }

  .packet-cover p {
    color: rgba(231, 225, 219, 0.82);
    overflow-wrap: anywhere;
  }

  .packet-sheet span,
  .tab-kicker {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .packet-label {
    color: #d8c76a;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .packet-sheet {
    position: absolute;
    right: var(--space-5);
    width: min(18rem, 42%);
    padding: var(--space-4);
  }

  .packet-sheet strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .packet-sheet:not(.muted) {
    top: var(--space-8);
  }

  .packet-sheet.muted {
    bottom: var(--space-8);
    background: var(--color-paper);
  }

  .program-facts {
    background: rgba(214, 208, 202, 0.72);
  }

  .program-facts-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr)) auto;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .program-fact {
    min-height: 4.5rem;
    display: grid;
    align-content: center;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-left: 1px solid var(--color-soft-border);
  }

  .program-fact:first-child {
    border-left: 0;
    background: rgba(135, 114, 31, 0.2);
    border-radius: var(--radius-md);
  }

  .program-fact span {
    color: var(--color-muted-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .program-fact strong {
    color: var(--color-ink);
    font-size: 1rem;
  }

  .program-facts-action {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    padding: 0.7rem 1rem;
    background: var(--color-navy);
    color: var(--color-white);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .program-section,
  .program-about,
  .program-inquiry-section {
    padding: var(--space-16) 0;
  }

  .program-section-heading {
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  .program-section-heading.centered {
    margin-inline: auto;
    text-align: center;
  }

  .program-section-heading p:not(.eyebrow) {
    color: var(--color-muted-ink);
    font-size: 1.1rem;
    line-height: 1.7;
